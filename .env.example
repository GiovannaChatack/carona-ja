# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# Na Vercel, cadastre as mesmas variáveis em Production e Preview.
# NUNCA coloque aqui a SUPABASE_SERVICE_ROLE_KEY nem qualquer outra chave secreta.

# URL do projeto Supabase (Project Settings → API → Project URL).
# Formato: https://<ref>.supabase.co, sem /rest/v1/ nem barra no final.
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública anon/publishable do Supabase (Project Settings → API).
# É segura no navegador porque todas as tabelas têm RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site, usada nos links enviados por e-mail.
# Em produção, use a URL da Vercel (ex.: https://carona-ja-theta.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente para os testes e2e (Playwright). Use uma conta de TESTE, nunca a conta do dono.
# Não cadastre estas variáveis na Vercel.
E2E_EMAIL=
E2E_SENHA=
